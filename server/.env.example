# Server
PORT=5000
NODE_ENV=development
# Local MongoDB: mongodb://127.0.0.1:27017/workconnect
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/workconnect
MONGODB_URI=mongodb://127.0.0.1:27017/workconnect
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h
CLIENT_URL=http://localhost:5173

# Initial admin setup (used only by `npm run seed` / `npm run create-admin`)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# Optional: maximum upload size in bytes (default 2 MB)
UPLOAD_MAX_BYTES=2097152
